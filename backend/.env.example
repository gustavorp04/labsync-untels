# Plantilla de variables de entorno para desarrollo LOCAL.
# Copia este archivo a `.env` (en la carpeta backend/) y ajusta los valores:
#   cp .env.example .env
# El archivo .env NO se sube al repositorio (está en .gitignore).
# En producción (Cloud Run / Docker / CI) estas variables se definen en el entorno.

# Activa el modo desarrollo (páginas de error detalladas, SECRET_KEY por defecto permitida).
DJANGO_DEBUG=true

# Clave secreta. En producción es OBLIGATORIA. En local puedes dejar este valor.
SECRET_KEY=django-insecure-desarrollo-local-no-usar-en-pro

# Base de datos. Por defecto usa la URL local de PostgreSQL.
# Para usar SQLite local, deja DATABASE_URL vacío y ajusta settings si lo necesitas.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/LabSyncUNTELS

# Hosts permitidos (separados por coma).
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes CORS permitidos (frontend local).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Configuración de correo (opcional en local; necesario para recuperación de contraseña).
EMAIL_HOST_USER=tu-correo-local@gmail.com
EMAIL_HOST_PASSWORD=tu-token-de-aplicacion
